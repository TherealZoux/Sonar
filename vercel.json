{
  "rewrites": [
    {
      "source": "/apple-api/:path*",
      "destination": "https://rss.marketingtools.apple.com/:path*"
    },
    {
      "source": "/itunes-api/:path*",
      "destination": "https://itunes.apple.com/:path*"
    },
     {
      "source": "/((?!api/|apple-api/|itunes-api/).*)",
      "destination": "/index.html"
    }

  ]
}
